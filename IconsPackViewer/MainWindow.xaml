<Window
    x:Class="IconBrowser.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MahApps IconPacks Browser"
    Width="1200"
    Height="600"
    MinWidth="900"
    MinHeight="600"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Window.Resources>

        <!--
            =========================================================
            ICON
            ==========================================================
        -->

        <DataTemplate x:Key="IconTemplate">

            <Button
                Margin="3"
                Padding="8"
                Background="Transparent"
                BorderBrush="#D8D8D8"
                BorderThickness="1"
                Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                CommandParameter="{Binding}"
                Cursor="Hand"
                ToolTip="Нажмите, чтобы скопировать XAML">

                <StackPanel HorizontalAlignment="Center">

                    <ContentControl
                        Width="{Binding DataContext.IconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                        Height="{Binding DataContext.IconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                        HorizontalAlignment="Center"
                        Content="{Binding Icon}" />

                    <TextBlock
                        MaxWidth="130"
                        Margin="0,6,0,0"
                        FontSize="10"
                        Foreground="#666666"
                        Text="{Binding KindName}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />

                </StackPanel>

            </Button>

        </DataTemplate>


        <!--
            =========================================================
            PACK
            ==========================================================
        -->

        <DataTemplate x:Key="PackTemplate">

            <Border
                Margin="0,0,0,18"
                Padding="14"
                Background="#FAFAFA"
                BorderBrush="#D0D0D0"
                BorderThickness="1"
                CornerRadius="6">

                <StackPanel>

                    <!--  Заголовок набора  -->

                    <DockPanel Margin="0,0,0,12">

                        <Button
                            Margin="10,0,0,0"
                            Padding="12,5"
                            Command="{Binding DataContext.TogglePackCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            Content="{Binding ExpandButtonText}"
                            DockPanel.Dock="Right" />

                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="21"
                            FontWeight="SemiBold"
                            Text="{Binding Name}" />

                        <TextBlock
                            Margin="5,4,0,0"
                            VerticalAlignment="Center"
                            FontSize="13"
                            Foreground="#777777"
                            Text="{Binding TotalCount, StringFormat='  ({0} icons)'}" />

                    </DockPanel>


                    <!--  Иконки  -->

                    <ItemsControl ItemTemplate="{StaticResource IconTemplate}" ItemsSource="{Binding Icons}">

                        <ItemsControl.ItemsPanel>

                            <ItemsPanelTemplate>

                                <UniformGrid Columns="10" />

                            </ItemsPanelTemplate>

                        </ItemsControl.ItemsPanel>

                    </ItemsControl>

                </StackPanel>

            </Border>

        </DataTemplate>

    </Window.Resources>


    <!--
        =============================================================
        MAIN LAYOUT
        =============================================================
    -->

    <DockPanel>


        <!--
            =========================================================
            TOP TOOLBAR
            ==========================================================
        -->

        <Border
            Padding="10"
            Background="#EEEEEE"
            BorderBrush="#CCCCCC"
            BorderThickness="0,0,0,1"
            DockPanel.Dock="Top">

            <DockPanel>


                <!--  Размер иконок  -->

                <StackPanel
                    VerticalAlignment="Center"
                    DockPanel.Dock="Right"
                    Orientation="Horizontal">

                    <TextBlock
                        Margin="0,0,7,0"
                        VerticalAlignment="Center"
                        Text="Размер:" />

                    <Slider
                        Width="130"
                        VerticalAlignment="Center"
                        Maximum="100"
                        Minimum="24"
                        Value="{Binding IconSize}" />

                    <TextBlock
                        Width="50"
                        VerticalAlignment="Center"
                        Text="{Binding IconSize, StringFormat=' {0:0}px'}" />

                </StackPanel>


                <!--  Поиск  -->

                <TextBox
                    Height="34"
                    Padding="8,4"
                    VerticalContentAlignment="Center"
                    FontSize="15"
                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                    ToolTip="Поиск по названию набора или иконки" />

            </DockPanel>

        </Border>


        <!--
            =========================================================
            STATUS BAR
            ==========================================================
        -->

        <Border
            Padding="8"
            Background="#F5F5F5"
            BorderBrush="#DDDDDD"
            BorderThickness="0,1,0,0"
            DockPanel.Dock="Bottom">

            <TextBlock Foreground="#666666" Text="{Binding StatusText}" />

        </Border>


        <!--
            =========================================================
            CONTENT
            ==========================================================
        -->

        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">

            <ItemsControl
                Margin="15"
                ItemTemplate="{StaticResource PackTemplate}"
                ItemsSource="{Binding Packs}" />

        </ScrollViewer>

    </DockPanel>

</Window>